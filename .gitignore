# Unreal Engine monorepo .gitignore
# Every project lives in a subfolder (NN_Name/Project), so the engine folders are
# matched at any depth with **/ (a pattern like "Saved/*" only matches at the repo root).

# Engine-generated folders
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/Build/*
!**/Build/*/
**/Build/*/**
!**/Build/*/PakBlacklist*.txt
!**/Build/**/*.ico

# Built lighting data for maps (regenerated when building lighting)
*_BuiltData.uasset

# Packaged builds
**/Packaged/
**/Windows/
**/WindowsNoEditor/

# IDE / generated project files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace
.vsconfig

# Compiled files
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.pdb
*.exe
*.out
*.app
*.ipa

# Source art exports
**/SourceArt/**/*.png
**/SourceArt/**/*.tga

# OS
.DS_Store
Thumbs.db
